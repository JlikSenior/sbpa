{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SBPA Extractor Candidate",
  "type": "object",
  "required": ["candidate_id", "evidence_id", "kind", "location"],
  "properties": {
    "candidate_id": {"type": "string", "pattern": "^X-[0-9]{6}$"},
    "evidence_id": {"type": "string", "pattern": "^E-[0-9]{6}$"},
    "kind": {"type": "string", "minLength": 1},
    "native_name": {"type": ["string", "null"]},
    "native_classification": {"type": ["string", "null"]},
    "location": {
      "type": "object",
      "required": ["path"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "start_line": {"type": ["integer", "null"], "minimum": 1},
        "end_line": {"type": ["integer", "null"], "minimum": 1}
      },
      "additionalProperties": true
    },
    "parent_candidate_id": {"type": ["string", "null"]},
    "relations": {"type": "array", "items": {"type": "string"}},
    "attributes": {"type": "object"},
    "extractor": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
